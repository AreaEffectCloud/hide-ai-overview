{
    "manifest_version": 3,
    "name": "Block AI Overviews",
    "version": "1.0",
    "description": "This extension hides all AI overviews when searching words on Google.",
    "permissions": ["declarativeNetRequest"],
    "host_permissions": ["*://www.google.com/*"],
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "ruleset_1",
                "enabled": true,
                "path": "rules.json"
            }
        ]
    }
}
